{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, X-API-KEY, Authorization, Origin" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/create-pix", "destination": "/api/create-pix" },
    { "source": "/api/check-status", "destination": "/api/check-status" },
    { "source": "/.netlify/functions/create-pix", "destination": "/api/create-pix" },
    { "source": "/.netlify/functions/check-status", "destination": "/api/check-status" },
    { "source": "/correios", "destination": "/index.html" },
    { "source": "/correios/", "destination": "/index.html" },
    { "source": "/1/confirmacao", "destination": "/1/confirmacao/index.html" },
    { "source": "/1/confirmacao/", "destination": "/1/confirmacao/index.html" },
    { "source": "/2/encomenda", "destination": "/2/encomenda/index.html" },
    { "source": "/2/encomenda/", "destination": "/2/encomenda/index.html" },
    { "source": "/upsell/1", "destination": "/upsell/1/index.html" },
    { "source": "/upsell/1/", "destination": "/upsell/1/index.html" },
    { "source": "/upsell/2", "destination": "/upsell/2/index.html" },
    { "source": "/upsell/2/", "destination": "/upsell/2/index.html" },
    { "source": "/upsell/3", "destination": "/upsell/3/index.html" },
    { "source": "/upsell/3/", "destination": "/upsell/3/index.html" },
    { "source": "/obrigado", "destination": "/obrigado/index.html" },
    { "source": "/obrigado/", "destination": "/obrigado/index.html" }
  ]
}
